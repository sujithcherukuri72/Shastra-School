###############################################################################
#  SHASTRA CONNECT - CONFIGURATION (.env)
#
#  Copy this file to ".env". NEVER commit .env or share it - it holds passwords.
#
#  Every setting is tagged:
#    [AUTO]  generated for you (start.ps1 fills these on first run). Keep secret.
#    [YOU]   YOU must obtain this before going live. Where to get it is written above it.
#    [OK]    sensible default, change only if you need to.
#
#  Local computer (development): works as-is - only the [AUTO] values are needed.
#  Production server: fill every [YOU] value, set the 4 "PRODUCTION SWITCHES",
#  then run:   npm run preflight     (tells you exactly what is still missing)
###############################################################################


# =============================================================================
# 1. PRODUCTION SWITCHES  (change all four when deploying to the server)
# =============================================================================
# [OK] development on your computer  ->  production on the server
NODE_ENV=development
# [OK] console = WhatsApp messages are only printed in the terminal  ->  meta (real WhatsApp)
WHATSAPP_PROVIDER=console
# [OK] mock = pretend payments for testing  ->  razorpay (real money)
PAYMENT_PROVIDER=mock
# [OK] true on your computer  ->  false on the server (the separate "worker" container runs jobs)
RUN_JOBS_IN_API=true


# =============================================================================
# 2. SCHOOL DETAILS  (shown in the app, receipts, report cards and WhatsApp messages)
# =============================================================================
# [YOU] confirm the exact official school name
SCHOOL_NAME=Shastra The New Age School
SCHOOL_SHORT_NAME=Shastra
SCHOOL_CITY=Suryapet
# [YOU] office phone + address printed on receipts and report cards (optional but recommended)
SCHOOL_PHONE=
SCHOOL_ADDRESS=
# [OK] receipt numbers look like SHS/2026-27/001234 (2-8 capital letters/digits)
RECEIPT_PREFIX=SHS
SCHOOL_TIMEZONE=Asia/Kolkata


# =============================================================================
# 3. WEBSITE ADDRESS  (production)
# =============================================================================
# [YOU] the web address parents will open, WITHOUT https://  e.g. connect.shastraschool.in
#       Buy/own a domain (GoDaddy, Hostinger, Namecheap, Google...) and create an
#       "A record" pointing this name to your server's public IP address.
DOMAIN=
# [YOU] an email address for the free HTTPS certificate (Let's Encrypt expiry notices)
ACME_EMAIL=

# [OK] local development only - the address of the app on your computer
APP_ORIGIN=http://localhost:5173
API_PORT=4100
TRUST_PROXY=1
LOG_LEVEL=info


# =============================================================================
# 4. DATABASE  (PostgreSQL 19 runs in Docker - nothing to buy)
# =============================================================================
# [AUTO] long random passwords
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser-password
DB_APP_PASSWORD=change-me-app-password
# [AUTO] must contain the same DB_APP_PASSWORD as above (used on your computer only)
DATABASE_URL=postgresql://shastra_app:change-me-app-password@localhost:5432/shastra
# [OK]
DB_NAME=shastra
DB_APP_USER=shastra_app
DB_HOST_PORT=5432


# =============================================================================
# 5. SECURITY
# =============================================================================
# [AUTO] at least 32 random characters. Changing it later only cancels pending login codes.
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
# [OK] staff are signed out after 12 hours; parents stay signed in for 30 days
STAFF_SESSION_HOURS=12
FAMILY_SESSION_DAYS=30
# [OK] largest upload (worksheets, answer sheets) in MB
MAX_UPLOAD_MB=15
UPLOAD_DIR=./storage


# =============================================================================
# 6. WHATSAPP  (Meta WhatsApp Business Cloud API) - needed for production
#    Step-by-step guide: docs/WHATSAPP.md
# =============================================================================
# What you need first:
#   - a Meta (Facebook) Business account for the school  -> business.facebook.com
#   - a phone number for the school that is NOT already used on the WhatsApp app
#   - an app with the "WhatsApp" product                 -> developers.facebook.com/apps
#   - the 7 message templates in docs/WHATSAPP.md approved in WhatsApp Manager
#
# [YOU] WhatsApp > API Setup > "Phone number ID" (a long number)
WHATSAPP_PHONE_NUMBER_ID=
# [YOU] Business Settings > System users > Generate token (permanent; permissions:
#       whatsapp_business_messaging + whatsapp_business_management)
WHATSAPP_ACCESS_TOKEN=
# [YOU] App settings > Basic > "App secret"
WHATSAPP_APP_SECRET=
# [AUTO] any long random text; paste the SAME value into Meta > WhatsApp > Configuration >
#        Webhook "Verify token". Callback URL: https://YOUR-DOMAIN/api/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=
# [OK]
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANG=en


# =============================================================================
# 7. ONLINE FEE PAYMENTS  (Razorpay: UPI, cards, net banking) - needed for production
# =============================================================================
# What you need first: a Razorpay account in the SCHOOL's name with KYC completed
#   (PAN, bank account, registration certificate)  -> dashboard.razorpay.com
#
# [YOU] Dashboard > Account & Settings > API Keys > Generate key  (starts with rzp_live_)
#       Use rzp_test_ keys first to try everything without real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# [YOU] Dashboard > Account & Settings > Webhooks > Add new webhook
#       URL: https://YOUR-DOMAIN/api/webhooks/razorpay
#       Events: payment.captured, payment.failed, order.paid
#       Secret: paste the value below into Razorpay (it is generated for you)
# [AUTO]
RAZORPAY_WEBHOOK_SECRET=


# =============================================================================
# 8. AUTOMATIC MESSAGES - send times (school time, 24h)
# =============================================================================
# [OK]
BIRTHDAY_SEND_TIME=08:00
FEE_REMINDER_TIME=09:00
MONTHLY_REPORT_TIME=10:00
