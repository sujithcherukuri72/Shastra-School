{
  "name": "@shastra/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --watch-preserve-output src/server.ts",
    "start": "node src/server.ts",
    "worker": "node src/worker.ts",
    "migrate": "node src/db/migrate.ts",
    "seed": "node src/db/seed.ts",
    "create-principal": "node src/db/create-principal.ts",
    "reset-mfa": "node src/db/reset-mfa.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "file-type": "22.3.0",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "pdfkit": "0.21.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.10",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "typescript": "7.0.2"
  }
}
